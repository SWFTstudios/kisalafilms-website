{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kisalafilms-website",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-07",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    /* Pages and the API go to the Worker first; plain files (CSS, JS,
       images, data) are served straight from the asset store. Without the
       Worker running first, the basic-auth gate on /internal/* never sees the
       request and the brand guide is public. Listing only /internal/* is not
       enough: with a pattern list, a path that matches nothing and has no
       file (every /api/* route, every retired-page redirect) gets the 404
       page instead of the Worker. */
    "run_worker_first": [
      "/*",
      "!/css/*",
      "!/js/*",
      "!/images/*",
      "!/data/*",
      "!/videos/*",
      "!/robots.txt",
      "!/sitemap.xml"
    ]
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kisalafilms",
      "database_id": "322e1428-a18a-4b3a-9f23-e381d44212e5",
      "migrations_dir": "migrations"
    }
  ],
  /* Set with: wrangler secret put STRIPE_SECRET_KEY
     Stripe webhooks (project checkout paid): wrangler secret put STRIPE_WEBHOOK_SECRET
     Optional: wrangler secret put SITE_URL  (defaults to the request host)
     Films import: wrangler secret put FILMS_IMPORT_TOKEN
     Founder admin (mark completed orders / force price sync):
     wrangler secret put FOUNDER_ADMIN_TOKEN
     Internal docs (HTTP basic auth for everything under /internal/, e.g.
     the brand style guide — unset means /internal/* refuses all requests):
     wrangler secret put STYLEGUIDE_PASSWORD */
  /* Client portal photos. Create once with:
       npx wrangler r2 bucket create kisalafilms-photos */
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "kisalafilms-photos"
    }
  ],
  /* Portal email (sign-in links, build updates). Sends only from a domain
     onboarded to Cloudflare Email Sending, named by EMAIL_FROM below:
       npx wrangler email sending enable <domain>
     Or set a Resend key instead: wrangler secret put RESEND_API_KEY
     With neither, mail is written to the Worker log. */
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "vars": {
    "SITE_URL": "https://kisalafilms-website.elombe.workers.dev",
    /* Who can open /admin, and where studio alerts go (first address). */
    "ADMIN_EMAILS": "elombe@swftstudios.com",
    /* e.g. "K Films <studio@yourdomain.com>". Empty until a domain is set up. */
    "EMAIL_FROM": ""
  }
}
