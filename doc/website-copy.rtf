{\pard \fs18 \i [Section \u183? New York City, specifically \u183? Card \u183? A city bike is a working bike \u183? h3]\i0\par}
{\pard \fs22 A city bike is a working bike\par}
{\pard \fs18 \i [Section \u183? New York City, specifically \u183? Card \u183? A city bike is a working bike \u183? body]\i0\par}
